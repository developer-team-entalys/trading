# ── Database ──────────────────────────────────────
POSTGRES_USER=botuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=usdjpy_bot
DATABASE_URL=postgresql://botuser:changeme@timescaledb:5432/usdjpy_bot

# ── cTrader Open API (IC Markets Demo) ────────────
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=9915559
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5035
CTRADER_ENV=demo              # demo or live

# ── Myfxbook Community Outlook (Sentiment) ─────────
# Free account at https://www.myfxbook.com/register
# No KYC, no broker account needed
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# ── Telegram Alerts ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Grafana ───────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=changeme

# ── Strategy Parameters ───────────────────────────
INSTRUMENT=USD_JPY
SYMBOL_NAME=USDJPY
MAX_POSITION_SIZE_LOTS=0.1        # Max 0.1 lots = $10,000 notional
MAX_DAILY_DRAWDOWN_EUR=50         # Stop trading if daily loss > €50
CONFIDENCE_THRESHOLD=0.65         # Minimum signal confidence to trade
ATR_MULTIPLIER_SL=1.5             # Stop loss = 1.5x ATR
ATR_MULTIPLIER_TP=2.5             # Take profit = 2.5x ATR

# ── COT Data ─────────────────────────────────────
COT_URL=https://www.cftc.gov/files/dea/history/fut_fin_txt_{year}.zip

# ── Timeframe ─────────────────────────────────────────────────
CANDLE_TIMEFRAME=M30
SENTIMENT_INTERVAL_MIN=30

# ── Risk Parameters ───────────────────────────────────────────
RISK_PER_TRADE_PCT=0.01

# ── Signal Parameters ─────────────────────────────────────────
TARGET_PIPS=15
TARGET_CANDLES_AHEAD=4

# ── Training Phase ────────────────────────────────────────────
TRAINING_PHASE=1
MIN_SENTIMENT_ROWS=2000
